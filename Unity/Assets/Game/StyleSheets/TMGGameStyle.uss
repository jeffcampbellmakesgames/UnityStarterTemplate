* {
    -unity-font: url('project://database/Assets/Game/Fonts/Urbanist/Urbanist-VariableFont_wght.ttf?fileID=12800000&guid=60cfd9f8585a34864ad23a075380b230&type=3#Urbanist-VariableFont_wght');
    -unity-font-definition: url('project://database/Assets/Game/Fonts/Urbanist/Urbanist-VariableFont_wght%20SDF.asset?fileID=11400000&guid=78e4a905def384f3ebc70a861aafa9a2&type=2#Urbanist-VariableFont_wght SDF');
}

Button {
    transition-property: all;
    transition-duration: 0.33s;
    border-color: rgb(0, 0, 0);
    border-width: 3px;
    border-radius: 25px;
}

Button:hover {
    transition-property: scale;
    scale: 1.05 1.05;
    transition-duration: 0.33s;
    transition-timing-function: ease-in-out;
}

Button:active {
    transition-property: translate;
    transition-timing-function: ease-out-bounce;
    transition-duration: 0.33s;
    scale: 1.08 1.08;
}

.unity-slider > .unity-label {
    width: 300px;
}

.unity-popup-field > .unity-label {
    width: 350px;
}

.title {
    font-size: 120px;
}

.h1 {
    font-size: 64px;
}

.h2 {
    font-size: 56px;
}

.h3 {
    font-size: 48px;
}

.h4 {
    font-size: 40px;
}

.start-button {
    border-radius: 30px;
    border-width: 5px;
    font-size: 48px;
    background-color: rgb(77, 141, 183);
    border-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    text-shadow: 2px 2px 1px rgb(0, 0, 0);
    -unity-font-style: bold;
    margin: 5px;
    padding: 5px;
    height: 70px;
}

.start-button:active {
    background-color: rgb(255, 0, 242);
    border-color: rgb(255, 255, 255);
}

.start-button:hover {
    background-color: rgb(37, 56, 75);
    border-color: rgb(255, 255, 255);
}

.start-button:focus {
    background-color: rgb(37, 56, 75);
    border-color: rgb(255, 255, 255);
}

.main-background {
    flex-grow: 1;
    background-color: rgb(255, 255, 255);
}

.save-data-list-item {
    justify-content: flex-start;
    align-self: stretch;
    flex-grow: 1;
    flex-shrink: 1;
    align-items: auto;
    background-color: rgb(255, 249, 249);
    border-color: rgb(0, 0, 0);
    border-width: 3px;
    border-radius: 25px;
    padding: 10px;
}

.list-item-container {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(0, 0, 0);
    margin: 5px;
    padding: 5px;
}

.list-item-container.unity-collection-view__item--selected {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(21, 21, 21);
}

.unity-list-view__empty-label {
    display: none;
}

.close-button {
    align-self: flex-end;
    justify-content: center;
    align-items: auto;
    width: 100px;
    height: 100px;
    right: 40px;
    border-left-color: rgb(86, 86, 86);
    border-right-color: rgb(86, 86, 86);
    border-top-color: rgb(86, 86, 86);
    border-bottom-color: rgb(86, 86, 86);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
}

.settings-header-button {
    flex-grow: 1;
    margin-right: 15px;
    margin-left: 15px;
    font-size: 48px;
    text-shadow: 2px 1px 2px rgb(0, 0, 0);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.settings-control {
    margin-top: 25px;
    margin-right: 50px;
    margin-bottom: 25px;
    margin-left: 50px;
    font-size: 42px;
    -unity-font-style: normal;
}

.settings-control-group {
    flex-grow: 1;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.settings-control-group-disabled {
    opacity: 0;
}

.title-group {
    flex-grow: 1;
    align-self: center;
    align-items: stretch;
    width: 50%;
    height: auto;
    justify-content: center;
    position: absolute;
    top: auto;
    left: 25%;
    right: 25%;
}
